# ==========================================
# 依赖 / Dependencies
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*

# ==========================================
# Next.js 构建产物 / Build output
# ==========================================
/.next/
/out/
/build

# ==========================================
# 环境变量 / Environment variables
#
# 重要：这些文件里通常放着密钥和私密配置，
# 一旦提交到公开仓库就等于泄露，绝对不能上传。
# ==========================================
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 调试日志 / Debug logs
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 部署平台 / Deployment
# ==========================================
.vercel
.netlify
.wrangler

# ==========================================
# 编辑器与系统文件 / Editor & OS files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea
.vscode/*
!.vscode/extensions.json

# ==========================================
# 临时文件 / Misc
# ==========================================
*.tsbuildinfo
*.log
